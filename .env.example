# ── Database ───────────────────────────────────────────────────────────
# Superuser connection, used ONLY by `pnpm db:bootstrap` to create roles.
DATABASE_ADMIN_URL="postgresql://postgres@localhost:5432/postgres"
DATABASE_NAME="magistrad"
# Owner role: runs migrations. Never used by the running application.
DATABASE_OWNER_URL="postgresql://magistrad_owner:dev-owner-password@localhost:5432/magistrad"
DATABASE_OWNER_PASSWORD="dev-owner-password"
# Application role: no table ownership, cannot bypass row-level security.
DATABASE_URL="postgresql://magistrad_app:dev-app-password@localhost:5432/magistrad"
DATABASE_APP_PASSWORD="dev-app-password"

# ── API ────────────────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL="http://localhost:3000/api"   # as seen by the browser (via the web app's proxy)
WEB_ORIGIN="http://localhost:3000"

# ── Identity provider (OpenID Connect) ─────────────────────────────────
# Development uses apps/dev-idp. Production points these at the managed provider.
OIDC_ISSUER="http://localhost:4400"
OIDC_CLIENT_ID="magistrad-web"
OIDC_CLIENT_SECRET="dev-only-client-secret"
# A sign-in is accepted only if the ID token's `amr` claim contains this value.
OIDC_REQUIRED_AMR="mfa"

# ── Dev identity provider only ─────────────────────────────────────────
DEV_IDP_PORT=4400
